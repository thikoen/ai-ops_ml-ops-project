# Copy to .env. Never commit your real .env.
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai
HOPSWORKS_PROJECT=your_project_name
HOPSWORKS_API_KEY=replace_with_your_project_api_key
# Use your own local MinIO credentials (password >= 8 characters).
MINIO_ROOT_USER=casmlops
MINIO_ROOT_PASSWORD=replace_with_a_local_password
# Leave these at their defaults for Docker Compose.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=rail-delay
HOPSWORKS_FEATURE_VERSION=1
